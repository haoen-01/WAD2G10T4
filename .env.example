# Runtime
APP_ENV=development
APP_TIMEZONE=Asia/Singapore
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
# Where the web app (Vite, apps/web) finds the API. Only VITE_* variables reach the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Persistence: shared development and deployment use Supabase PostgreSQL.
# (The older name SILVERLOOP_RUNTIME_PROFILE still works; CAREPLUS_ wins if both are set.)
CAREPLUS_RUNTIME_PROFILE=shared
# Supabase on an IPv4-only network: replace this with the Session pooler URL from Dashboard > Connect.
# Keep port 5432 for migrations and note that the username includes the project reference.
# Never commit the real value.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Optional pool tuning for a server database (ignored for SQLite). The defaults keep one process
# under the session pooler's 15-client cap (10 + 4 = 14) and skip the round trip a pre-ping costs
# on every checkout. Instead the pool is LIFO (a checkout reuses the connection returned most
# recently), and a connection that sat idle in the pool for PING_IDLE_SECONDS or longer is pinged
# on checkout and replaced before any query runs on it if the ping fails. A connection returned
# more recently than that is not pinged, so one the pooler closes within that window still fails
# the first query that uses it, and nothing retries that query. Connections are also replaced
# once they are two minutes old (the pooler's idle timeout has not been measured); raise the
# recycle only once it has. PRE_PING=true pings every checkout instead of only idle ones.
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=4
# DATABASE_POOL_RECYCLE_SECONDS=120
# DATABASE_POOL_PRE_PING=false
# DATABASE_POOL_USE_LIFO=true
# DATABASE_POOL_PING_IDLE_SECONDS=30
# TCP keepalives on psycopg connections: first probe after IDLE seconds, then every INTERVAL
# seconds, dropped after COUNT unanswered probes. Keeps idle sockets from being silently dropped
# by the network; it does not reset the pooler's own idle timeout. A keepalives_* value in
# DATABASE_URL wins over these.
# DATABASE_POOL_KEEPALIVES=true
# DATABASE_POOL_KEEPALIVES_IDLE_SECONDS=30
# DATABASE_POOL_KEEPALIVES_INTERVAL_SECONDS=10
# DATABASE_POOL_KEEPALIVES_COUNT=3

# Authentication — defaults to enabled. Set AUTH_ENABLED=false only for offline/test.
AUTH_ENABLED=true
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Optional: only for explicitly configured legacy HS256 projects.
SUPABASE_JWT_SECRET=

# Web client (Vite) Supabase credentials. Only variables prefixed VITE_ are exposed to browser code,
# so these are public by design: the URL and the PUBLISHABLE key, never a secret key. The web app
# uses Supabase for sign-in and the session only; every read and write goes through the API.
VITE_AUTH_ENABLED=true
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin setup command only — never commit or expose this key
SUPABASE_SECRET_KEY=

# Demo-only controls
DEMO_SEED=2026
DEMO_SCENARIO_VERSION=v1

# External integrations are optional. Fixture mode must always work.
ADAPTER_MODE=fixture
# Outreach planner (silverloop.agent). Off by default: the whole demo, every test and the
# offline profile run without it, and the deterministic ranker selects the candidate instead.
# When enabled, the planner only chooses which permitted candidate to send and how to word it --
# it can never change a consent, data-quality, confidence, contact-cap or human-review gate.
LLM_ENABLED=false
# Which surface serves the planner.
#   anthropic -> the first-party API. Authenticated by LLM_API_KEY, billed to an Anthropic
#                account. Note that a Claude Pro/Max subscription does NOT include API credit.
#   bedrock   -> Amazon Bedrock via the Messages-API (Mantle) endpoint. Authenticated by the
#                ambient AWS credential chain -- IAM role, environment, or profile -- and billed
#                to your AWS account, so LLM_API_KEY is not used. Enable model access for the
#                model in the Bedrock console, in the region you set below, before switching.
# Every feature the planner depends on -- strict tool use, adaptive thinking, effort and prompt
# caching -- is generally available on both, so this is a commercial choice, not a functional one.
LLM_PROVIDER=anthropic
# `recorded` replays a synthetic recording file instead of calling any provider; it is the only
# provider the offline profile accepts with LLM_ENABLED=true, and it needs LLM_RECORDING_PATH
# pointing at a recording file or directory. No recordings are committed.
# LLM_PROVIDER=recorded
# LLM_RECORDING_PATH=
LLM_API_KEY=
# Bedrock only. Blank defers to the SDK (AWS_REGION, or the active profile). The runtime check
# refuses to start with LLM_PROVIDER=bedrock and no region anywhere, rather than letting the
# planner degrade silently to the ranker mid-demo.
LLM_AWS_REGION=
# Bedrock only, and all three optional. Leave blank to use the ambient AWS credential chain (an
# IAM role, real AWS_* environment variables, or a configured profile) -- the right answer for
# anything deployed. They exist because this file is read into Settings and is NEVER exported to
# the process environment, so putting AWS_ACCESS_KEY_ID here would not reach the SDK; these do.
# Set the first two together or neither. The session token is required for temporary STS
# credentials, which expire -- if the planner starts reporting fallback_error after working, an
# expired token is the first thing to check. Never commit real values; this file is the template.
LLM_AWS_ACCESS_KEY_ID=
LLM_AWS_SECRET_ACCESS_KEY=
LLM_AWS_SESSION_TOKEN=
# Bedrock only. Which Bedrock surface to call.
#   mantle -> bedrock-mantle:CreateInference, the Messages-API endpoint. Preferred.
#   invoke -> the legacy bedrock-runtime:InvokeModel path. Same SDK and message shapes; it
#             exists because an AWS Organizations service control policy can deny one action and
#             permit the other, and an SCP cannot be overridden from inside the account. If
#             mantle returns 403 naming bedrock-mantle:CreateInference, try invoke.
LLM_BEDROCK_ENDPOINT=mantle
# Which request features to send.
#   modern -> adaptive thinking, output_config.effort, strict tool schemas, prompt caching.
#             What every current Claude model expects.
#   legacy -> none of those four. Older models (Claude 3.x) reject each of them with a 400
#             rather than ignoring it. This costs the strict argument-validation guarantee, the
#             reasoning-budget control and prompt caching; it does NOT touch the guardrail,
#             which validates the model's output and is the actual security boundary. The mode
#             is recorded on every agent run, so the evidence says which shape was sent.
LLM_REQUEST_PROFILE=modern
# Whether to ask for extended thinking. `adaptive` is what current first-party models take;
# `off` omits it. Separate from the profile because thinking support is a property of the MODEL
# while the profile is a property of the SURFACE -- Claude Haiku 4.5 rejects adaptive thinking
# but accepts strict tool schemas and prompt caching, so it needs modern + off rather than the
# full legacy profile.
LLM_THINKING=adaptive
#
# Verified working against Amazon Bedrock on 2026-09-06 (mode=agent, 3 iterations, guardrail
# approved), on a hackathon account whose service control policies deny the Mantle endpoint
# org-wide:
#   LLM_PROVIDER=bedrock
#   LLM_AWS_REGION=us-east-1
#   LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0   # the `us.` inference profile, not
#                                                           # the bare model id
#   LLM_BEDROCK_ENDPOINT=invoke
#   LLM_REQUEST_PROFILE=modern
#   LLM_THINKING=off
#   LLM_MAX_RETRIES=4
#   LLM_TIMEOUT_SECONDS=45
# That combination keeps `strict: true` and prompt caching; only adaptive thinking and
# `output_config.effort` are unavailable, neither of which the guardrail depends on.
# Blank uses the pinned id for the selected provider: claude-opus-5 on the first-party API,
# anthropic.claude-opus-5 on Bedrock (Bedrock ids carry the prefix).
LLM_MODEL=
# Hard cap on planner iterations per outreach. Clamped to ITERATION_HARD_CEILING (8).
LLM_MAX_ITERATIONS=4
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=20
# SDK-level retries per request. 1 favours fast, visible degradation -- a provider problem should
# surface as fallback_error rather than hide behind a long retry chain mid-demo. Raise it on a
# rate-limited account: a shared or throttled Bedrock quota can 429 the second turn of a planning
# loop that started fine, and the SDK backs off and retries 429s automatically. Retries happen
# inside one iteration, so the hard iteration cap is unaffected.
LLM_MAX_RETRIES=1

# Kaki, the Care+ assistant (silverloop.assistant). Server-side only: the key is read by the API
# and never sent to the browser. NEVER put it in a VITE_ variable. Leave it empty to use the
# built-in helper (no outside call); the offline profile always uses the helper. When set, the
# question, the last few turns and a short summary of what that person can already see in Care+
# (the senior's name, recent steps, appointments in the next two weeks) go to OpenAI. See
# docs/adr/0013-care-plus-assistant.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=20
# Questions one person may ask in 10 minutes.
# ASSISTANT_RATE_PER_10_MIN=30

# Optional, best-effort live weather/public-holiday context (silverloop.context). Off by default;
# it is also force-disabled under CAREPLUS_RUNTIME_PROFILE=offline regardless of this flag, so
# the offline demo and Playwright never make network calls.
EXTERNAL_CONTEXT_ENABLED=false