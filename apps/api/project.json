{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.runtime check && uv run alembic upgrade head && uv run uvicorn silverloop.main:app --reload --host 127.0.0.1 --port 8000"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/api",
        "command": "uv build --no-build-isolation"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run pytest"
      }
    },
    "test-postgres": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run pytest tests/test_postgres_integration.py -m postgres"
      }
    },
    "test-scenarios": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.scenarios ../../scenarios"
      }
    },
    "evaluate": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/docs/evaluation"],
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation ../../scenarios --out ../../docs/evaluation"
      }
    },
    "evaluate-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation ../../scenarios --out ../../docs/evaluation --check"
      }
    },
    "evaluate-ranking": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/docs/evaluation"],
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation.ranking --out ../../docs/evaluation"
      }
    },
    "evaluate-ranking-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation.ranking --out ../../docs/evaluation --check"
      }
    },
    "runtime-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.runtime check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run ruff check src tests"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run ruff format src tests"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run ruff format --check src tests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m compileall -q src tests"
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/openapi/silverloop.json"],
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.openapi"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run alembic upgrade head"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.seed"
      }
    },
    "demo-reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "curl --fail --silent --show-error -X POST http://127.0.0.1:8000/v1/demo/reset"
      }
    },
    "demo-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.smoke"
      }
    },
    "supabase-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.supabase_smoke"
      }
    },
    "evaluate-ranking-llm": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/docs/evaluation"],
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation.ranking_llm --out ../../docs/evaluation"
      }
    },
    "evaluate-ranking-llm-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation.ranking_llm --out ../../docs/evaluation --check"
      }
    },
    "evaluate-calibration": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/docs/evaluation"],
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation.calibration --out ../../docs/evaluation"
      }
    },
    "evaluate-calibration-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "command": "uv run python -m silverloop.evaluation.calibration --out ../../docs/evaluation --check"
      }
    }
  },
  "tags": ["scope:backend", "type:app"]
}
