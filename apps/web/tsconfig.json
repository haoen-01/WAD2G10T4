{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": false,
    "allowJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.vue"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.js"]
}
