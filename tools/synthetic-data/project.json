{
  "name": "synthetic-data",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tools/synthetic-data",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/api python tools/synthetic-data/generate.py --days 28"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/api python -m compileall -q tools/synthetic-data/generate.py"
      }
    }
  },
  "tags": ["scope:tooling", "type:data"]
}
