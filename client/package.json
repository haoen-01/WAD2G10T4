{
  "name": "@silverloop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/typecheck.mjs && tsc --noEmit -p tsconfig.api-client.json",
    "test": "node --import ./scripts/resolve-ts.mjs --test src/lib/*.test.ts && vitest run",
    "test:stores": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.1",
    "bootstrap": "5.3.9",
    "maplibre-gl": "6.18.0",
    "motion-v": "2.12.0",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
